@startuml tinyserve-pipeline
' Living diagram of tinyserve's generation pipeline.
' Update as we go: change a box color/label, add boxes rightward (KV cache, server).
'   blue  = understood/built   amber = working on now   gray dashed = coming up
left to right direction
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam rectangle {
  FontColor #1f2937
  FontSize 13
  BorderThickness 2
}
title tinyserve: the generation pipeline

rectangle "**Text**\n\"The cat sat\"" as text #back:dbeafe;line:2563eb
rectangle "**Tokenize**\ntext <-> ID numbers" as tok #back:dbeafe;line:2563eb
rectangle "**Embeddings**\nIDs -> vectors (512-d)" as emb #back:dbeafe;line:2563eb
rectangle "**Transformer**\nattention + MLP\n// you are here //" as xf #back:fef3c7;line:d97706
rectangle "**Next-token scores**\n~50k token scores" as scores #back:f3f4f6;line:9ca3af;line.dashed
rectangle "**Pick a token**\nsample one" as pick #back:f3f4f6;line:9ca3af;line.dashed

text  -> tok
tok   -> emb
emb   -> xf
xf    -> scores
scores -> pick
pick  ..> text : append the new token, repeat\n(this loop is text generation)

legend bottom
|<#dbeafe>   | understood |
|<#fef3c7>   | working on now |
|<#f3f4f6>   | coming up |
endlegend
@enduml
